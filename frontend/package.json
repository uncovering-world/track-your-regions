{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Track Your Regions Frontend - Next Gen",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/test-report.mjs frontend-unit",
    "test:watch": "vitest",
    "test:coverage": "node ../scripts/test-report.mjs frontend-coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node ../scripts/test-report.mjs e2e-smoke",
    "test:e2e:full": "node ../scripts/test-report.mjs e2e-full",
    "size": "size-limit",
    "knip": "knip --include files,dependencies,unlisted",
    "knip:full": "knip"
  },
  "size-limit": [
    {
      "name": "entry chunk (gzip)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "825 kB"
    },
    {
      "name": "stylesheet (gzip)",
      "path": "dist/assets/index-*.css",
      "gzip": true,
      "limit": "10 kB"
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@turf/turf": "^7.3.2",
    "jwt-decode": "^4.0.0",
    "maplibre-gl": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^7.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/compression": "^1.8.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "compression": "^1.8.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "jsdom": "^26.0.0",
    "knip": "^5.84.1",
    "playwright": "^1.58.0",
    "size-limit": "^13.0.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
