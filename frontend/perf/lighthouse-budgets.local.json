{
  "urls": [
    {
      "url": "http://localhost:{port}/wv/{worldView}",
      "expectRequestMatching": "/tile_"
    },
    "http://localhost:{port}/discover/wv/{worldView}",
    {
      "url": "http://localhost:{port}/wv/{worldView}/r/{region}",
      "expectRequestMatching": "/api/experiences/by-region/{region}?",
      "assertions": {
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1220000
          }
        ],
        "resource-summary:total:count": [
          "error",
          {
            "maxNumericValue": 58
          }
        ]
      }
    },
    {
      "url": "http://localhost:{port}/wv/{worldView}/r/{region}/e/{experience}",
      "expectRequestMatching": [
        "/api/experiences/by-region/{region}?",
        "/api/experiences/{experience}"
      ],
      "assertions": {
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1685000
          }
        ],
        "resource-summary:total:count": [
          "error",
          {
            "maxNumericValue": 104
          }
        ]
      }
    }
  ],
  "worldView": 5,
  "region": 6737,
  "experience": 6185,
  "port": 5173,
  "expectRequestMatching": "/api/world-views/{worldView}/",
  "runs": 3,
  "chromeFlags": [
    "--headless=new"
  ],
  "outputDir": "lighthouse-report/local",
  "assertions": {
    "resource-summary:script:size": [
      "error",
      {
        "maxNumericValue": 600000
      }
    ],
    "resource-summary:stylesheet:size": [
      "error",
      {
        "maxNumericValue": 12100
      }
    ],
    "resource-summary:font:size": [
      "error",
      {
        "maxNumericValue": 85000
      }
    ],
    "resource-summary:total:size": [
      "error",
      {
        "maxNumericValue": 965000
      }
    ],
    "resource-summary:total:count": [
      "error",
      {
        "maxNumericValue": 60
      }
    ],
    "largest-contentful-paint": [
      "warn",
      {
        "maxNumericValue": 2500
      }
    ],
    "total-blocking-time": [
      "warn",
      {
        "maxNumericValue": 1200
      }
    ],
    "cumulative-layout-shift": [
      "warn",
      {
        "maxNumericValue": 0.02
      }
    ],
    "interactive": [
      "warn",
      {
        "maxNumericValue": 3500
      }
    ],
    "categories:performance": [
      "warn",
      {
        "minScore": 0.5
      }
    ]
  }
}
