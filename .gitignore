/package-lock.json

# Large data files
*.gpkg
*.geojson
*.dump
*.har

# Legacy deployment dir (untracked GADM data)
deployment/

# Claude Code (local settings are machine-specific)
.claude/settings.local.json

# Playwright MCP
.playwright-mcp/

# Inbox (local scratchpad, not for version control)
docs/inbox/

# Plans and design specs are local working documents. What gets committed is
# documentation of what exists, under docs/tech/ — a committed plan drifts from
# reality and becomes a second, wrong source of truth.
# Note: this hides new plans only. Docs already tracked here stay tracked.
docs/tech/planning/

# Debug screenshots
*.png

# Binary artifacts
*.dmg

# Repomix output
repomix-output.*

# Generated cache files (Wikivoyage extraction cache, CV test data)
data/cache/
data/cv-python-tests/

# Experience images downloaded at runtime, and CV/matching debug dumps
data/images/
data/cv-debug/
data/matching-dumps/
# Local sync fixtures (SYNC_SOURCE_FIXTURE) — development-only source substitutes
data/sync-fixtures/

# Canon sync cache and CV model artifacts, both downloaded/written at runtime.
# Also catches the cache landing here when the backend runs with cwd=backend/.
backend/data/

# Design-system sync: local converter staging area and its generated bundle
.ds-sync/
ds-bundle/

# Isolated test stack's runtime data (see scripts/test-stack.sh)
.test-data/

# Superpowers skill working directory
.superpowers/
