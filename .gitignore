.playwright-mcp/

# Local, unpublished work: plans per issue, research drafts, session state,
# the inbox and the archive (docs/README.md § Where things live, ADR-0079).
# What gets committed is documentation of what exists — a committed plan
# drifts from reality and becomes a second, wrong source of truth.
docs/local/
# The old homes of plans and the inbox, kept ignored while they are
# symlinks into docs/local/ for the sessions that still use the old paths.
docs/inbox
docs/tech/planning

# Debug screenshots
*.png

# Binary artifacts
*.dmg

# Repomix output
repomix-output.*

# Generated cache files (Wikivoyage extraction cache, CV test data)
data/cache/
data/cv-python-tests/

# Experience images downloaded at runtime, and CV/matching debug dumps
data/images/
data/cv-debug/
data/matching-dumps/
# Local sync fixtures (SYNC_SOURCE_FIXTURE) — development-only source substitutes
data/sync-fixtures/

# Canon sync cache and CV model artifacts, both downloaded/written at runtime.
# Also catches the cache landing here when the backend runs with cwd=backend/.
backend/data/

# Design-system sync: local converter staging area and its generated bundle
.ds-sync/
ds-bundle/

# Isolated test stack's runtime data (see scripts/test-stack.sh)
.test-data/

# Superpowers skill working directory
.superpowers/

# The api:client check's scratch output (frontend/scripts/api-client.mjs), left behind
# only when a check is interrupted.
frontend/src/api/client.check.generated.ts
