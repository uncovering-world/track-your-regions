{
  "name": "@tyr/shared",
  "version": "0.0.0",
  "private": true,
  "description": "The pure rules both the backend and the frontend apply, declared once (ADR-0065)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api": "./src/api.generated.ts",
    "./auth": "./src/auth.ts",
    "./catalogue": "./src/catalogue.ts",
    "./curationLog": "./src/curationLog.ts",
    "./equality": "./src/equality.ts",
    "./geometry": "./src/geometry.ts",
    "./labels": "./src/labels.ts",
    "./moves": "./src/moves.ts",
    "./pictures": "./src/pictures.ts",
    "./runStatuses": "./src/runStatuses.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip --include files,dependencies,unlisted",
    "knip:full": "knip"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "knip": "^5.84.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
